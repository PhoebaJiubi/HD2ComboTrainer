                     <property name="styleSheet">
                      <string notr="true">QSpinBox#TimeAttack_countSpinBox {
    background-color: #2a2a4e;
    color: #ffffff;
    border: 2px solid #3a3a5a;
    border-radius: 6px;
    padding: 6px 12px;
    font-family: &quot;Microsoft YaHei&quot;;
    font-size: 18px;
    min-width: 80px;
}

/* 取消聚焦时的金色高亮 */
QSpinBox#spinBox:focus {
    border-color: #3a3a5a;
}

/* 上下按钮背景 */
QSpinBox#spinBox::up-button,
QSpinBox#spinBox::down-button {
    background-color: #2a2a4e;
    border: none;
    width: 22px;
}

QSpinBox#spinBox::up-button:hover,
QSpinBox#spinBox::down-button:hover {
    background-color: #3a3a5e;
}

/* 金色向上箭头 */
QSpinBox#spinBox::up-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 6px solid #ffd966;
}

/* 金色向下箭头 */
QSpinBox#spinBox::down-arrow {
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #ffd966;
}</string>
