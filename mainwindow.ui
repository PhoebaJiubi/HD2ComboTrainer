  <property name="styleSheet">
   <string notr="true">/* ===== 全局背景 ===== */
QMainWindow, QWidget {
    background-color: #0f0f1a;
    color: #c0c0d0;
    font-family: &quot;Microsoft YaHei&quot;;
}

/* ===== 所有标签 ===== */
QLabel {
    color: #c0c0d0;
}

/* ===== 所有按钮 ===== */
QPushButton {
    background-color: #1a1a2e;
    color: #c0c0d0;
    border: 2px solid #2a2a4a;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #2a2a4e;
    border-color: #4a4a7a;
}
QPushButton:pressed {
    background-color: #3a3a5e;
    border-color: #ffcc00;
}

/* ===== 滚动条 ===== */
QScrollBar:vertical {
    background-color: #0f0f1a;
    width: 12px;
    border-radius: 6px;
}
QScrollBar::handle:vertical {
    background-color: #2a2a4a;
    border-radius: 6px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background-color: #3a3a6a;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* ===== 分组框（卡片容器） ===== */
QGroupBox {
    background-color: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 10px;
    margin-top: 12px;
    padding-top: 8px;
}
QGroupBox::title {
    color: #ffcc00;
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 8px;
}

/* ===== 进度条 ===== */
QProgressBar {
    background-color: #0f0f1a;
    border: 1px solid #2a2a4a;
    border-radius: 4px;
    height: 6px;
    text-align: center;
}
QProgressBar::chunk {
    background-color: #ff8800;
    border-radius: 4px;
}

/* ===== 输入框 ===== */
QLineEdit, QTextEdit {
    background-color: #0f0f1a;
    border: 2px solid #2a2a4a;
    border-radius: 6px;
    color: #c0c0d0;
    padding: 6px 10px;
}
QLineEdit:focus, QTextEdit:focus {
    border-color: #ffcc00;
}

/* ===== 下拉框 ===== */
QComboBox {
    background-color: #1a1a2e;
    border: 2px solid #2a2a4a;
    border-radius: 6px;
    padding: 6px 10px;
    color: #c0c0d0;
}
QComboBox:hover {
    border-color: #4a4a7a;
}
QComboBox::drop-down {
    border: none;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #c0c0d0;
    margin-right: 6px;
}</string>
