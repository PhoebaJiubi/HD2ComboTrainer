                  <widget class="QListWidget" name="TimeAttack_detailList">
                   <property name="styleSheet">
                    <string notr="true">QListWidget#TimeAttack_detailList QScrollBar:vertical {
    background: #1e1e2e;
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QListWidget#TimeAttack_detailList QScrollBar::handle:vertical {
    background: #ffcc00;
    min-height: 30px;
    border-radius: 5px;
}

QListWidget#TimeAttack_detailList QScrollBar::handle:vertical:hover {
    background: #ffe066;
}

QListWidget#TimeAttack_detailList QScrollBar::handle:vertical:pressed {
    background: #e6b800;
}

/* 上下箭头去掉 */
QListWidget#TimeAttack_detailList QScrollBar::add-line:vertical,
QListWidget#TimeAttack_detailList QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

/* 去掉上下按钮区域 */
QListWidget#TimeAttack_detailList QScrollBar::add-page:vertical,
QListWidget#TimeAttack_detailList QScrollBar::sub-page:vertical {
    background: none;
}

/* ---------- 横向滚动条（如果也用到） ---------- */
QListWidget#TimeAttack_detailList QScrollBar:horizontal {
    background: #1e1e2e;
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QListWidget#TimeAttack_detailList QScrollBar::handle:horizontal {
    background: #ffcc00;
    min-width: 30px;
    border-radius: 5px;
}

QListWidget#TimeAttack_detailList QScrollBar::handle:horizontal:hover {
    background: #ffe066;
}

QListWidget#TimeAttack_detailList QScrollBar::add-line:horizontal,
QListWidget#TimeAttack_detailList QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QListWidget#TimeAttack_detailList QScrollBar::add-page:horizontal,
QListWidget#TimeAttack_detailList QScrollBar::sub-page:horizontal {
    background: none;
}</string>
